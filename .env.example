APP_ENV=development
SECRET_KEY=figureforge3d-change-this-in-production
DEBUG=true
POSTGRES_PASSWORD=ff3d_secret
MINIO_ROOT_USER=ff3d_admin
MINIO_ROOT_PASSWORD=ff3d_minio_secret
MINIO_BUCKET_NAME=figureforge3d
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# JWT 시크릿 — 절대 깃에 커밋하지 말 것. openssl rand -hex 32 등으로 생성.
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-please-do-not-leave-default
